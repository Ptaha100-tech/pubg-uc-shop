# ── База ──────────────────────────────────────────────────
POSTGRES_PASSWORD=поменяйте_на_длинный_случайный_пароль

# ── Telegram ──────────────────────────────────────────────
BOT_TOKEN=123456:ABC-from-BotFather
BOT_USERNAME=my_uc_shop_bot
PUBLIC_URL=https://shop.example.com
# Любая случайная строка из букв, цифр, _ и - (например: openssl rand -hex 24)
WEBHOOK_SECRET=замените_на_случайную_строку
# Ваш Telegram ID (узнать: @userinfobot). Несколько — через запятую.
ADMIN_IDS=123456789
# Необязательно: ID группы/чата, куда падают заказы (вместо личных сообщений админам)
# ADMIN_CHAT_ID=-1001234567890
SUPPORT_USERNAME=my_support_username

# ── ЮKassa ────────────────────────────────────────────────
YOOKASSA_SHOP_ID=000000
YOOKASSA_SECRET_KEY=live_xxxxxxxxxxxxxxxxxxxxxxxx

# Чеки по 54-ФЗ. Включите, если в ЮKassa подключена отправка чеков:
# тогда Mini App запросит email покупателя. Параметры уточните у бухгалтера.
RECEIPT_ENABLED=false
RECEIPT_VAT_CODE=1
# RECEIPT_TAX_SYSTEM_CODE=2
RECEIPT_PAYMENT_SUBJECT=service
RECEIPT_PAYMENT_MODE=full_payment

# ── Магазин ───────────────────────────────────────────────
SUPPLIER=manual
DELIVERY_ETA_TEXT=обычно до 15 минут
ORDER_TTL_MINUTES=70
MAX_PENDING_ORDERS=5
TIMEZONE=Europe/Moscow
